# Backend API Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Connection String
# Local MongoDB with authentication (recommended):
# mongodb://inquiry_app_user:<DB_PASSWORD>@127.0.0.1:27017/inquiry_db?authSource=inquiry_db
# Or local MongoDB without auth during initial setup:
# mongodb://127.0.0.1:27017/inquiry_db
MONGODB_URI=mongodb://127.0.0.1:27017/inquiry_db

# Admin Credentials
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=AdminPass2026!

# Allowed CORS Origins (comma separated)
ALLOWED_ORIGINS=http://13.214.151.97,http://13.214.151.97:8080,http://localhost:80,http://localhost:8080
